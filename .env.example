# Copy to .env and fill in. NEVER commit .env
# Keep comments on their own lines (inline comments break Makefile parsing).

# ---------- General ----------
TZ=Asia/Kolkata
# dev: your quick-tunnel URL; prod: https://n8n.yourdomain.com/   (must end with /)
PUBLIC_URL=https://your-subdomain.trycloudflare.com/

# ---------- n8n ----------
# generate with: openssl rand -hex 32   (never change it after creating credentials)
N8N_ENCRYPTION_KEY=

# ---------- Database: Supabase > Connect > Session pooler (port 5432) ----------
# Used by the API, n8n (via the n8n credential) and migrations.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Used only by the dashboard. Create a read-only role (see docs/runbook.md) and put its URL here.
# Until you create one, you can temporarily reuse DATABASE_URL.
DASHBOARD_DATABASE_URL=

# ---------- Internal API key (n8n -> FastAPI). generate: openssl rand -hex 24 ----------
SAATHI_API_KEY=

# ---------- Gemini: aistudio.google.com > Get API key ----------
GEMINI_API_KEY=
# alias that tracks the current Flash model; or pin a model name shown in AI Studio
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# ---------- Telegram: @BotFather ----------
TELEGRAM_BOT_TOKEN=
# your own Telegram id (from @userinfobot); error alerts go here
ADMIN_TELEGRAM_CHAT_ID=

# ---------- WhatsApp Cloud API (phase 5 only) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# use the Graph API version shown in your Meta app dashboard
WHATSAPP_API_VERSION=v21.0

# ---------- API tuning ----------
# Keep small: Supabase free tier limits connections, and the API shares them with n8n.
DB_POOL_MAX=3
MAX_UPLOAD_MB=20

# ---------- Dashboard ----------
DASHBOARD_PASSWORD=

# ---------- Production tunnel: Cloudflare Zero Trust > Networks > Tunnels ----------
CLOUDFLARE_TUNNEL_TOKEN=

# ---------- Golden tests (same value as the Header Auth credential on WF03) ----------
GOLDEN_URL=http://localhost:5678/webhook/saathi-test
GOLDEN_TOKEN=
